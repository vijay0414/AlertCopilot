# ──────────────────────────────────────────────
# Alert Arbitration Co-Pilot — .gitignore
# Covers: Python (FastAPI backend) + React/Vite frontend
# ──────────────────────────────────────────────

# ── Environment & Secrets ─────────────────────
.env
.env.local
.env.*.local
*.env

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
.env/
venv.bak/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# ── Fleet log data (runtime generated) ────────
data/fleet_log.jsonl
data/*.jsonl

# ── Node / React / Vite ───────────────────────
frontend/node_modules/
node_modules/

# Vite build output
frontend/dist/
frontend/.vite/

# npm / yarn / pnpm lock (keep package-lock.json, ignore others)
yarn.lock
pnpm-lock.yaml
.pnpm-store/

# Vite / React cache
frontend/.cache/

# ── OS files ──────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDE / Editor ──────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── Logs ──────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Misc ──────────────────────────────────────
*.bak
*.tmp
*.temp
.cache/
