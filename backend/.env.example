# ──────────────────────────────────────────────────────────────
# Alert Arbitration Co-Pilot — Environment Variables
# Copy this file to .env and fill in your real values
# ──────────────────────────────────────────────────────────────

# Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq model (default: llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# Optional: LLM timeout in seconds before falling back to templates (default: 2)
# LLM_TIMEOUT_SECONDS=2

# Optional: path to fleet log file (default: data/fleet_log.jsonl)
# FLEET_LOG_PATH=data/fleet_log.jsonl

